# Environment variables for PlayBeat TV
# Copy this file to `.env` and fill in real values.
# In production (Vercel), set these in the Vercel dashboard or via `vercel env add`.

# ============================================================
# REQUIRED
# ============================================================

# Postgres connection string from your hosted DB provider
# Vercel Postgres (Neon): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/playbeattv?sslmode=require
# Neon direct:            postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/playbeattv?sslmode=require
# Supabase:               postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="file:./dev.db"

# Secret string that protects admin endpoints — make it long and random
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=""

# Random 32+ char string for cookie signing
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ============================================================
# OPTIONAL — Free Content Auto-Import
# ============================================================

# Google Cloud API key with YouTube Data API v3 enabled
# Without this, only Wikimedia Commons imports work
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=""

# ============================================================
# OPTIONAL — Premium IPTV (reseller-managed lines only)
# ============================================================

# Your Xtream Masters reseller API key
# Without this, IPTV runs in demo mode (UI works, no real provisioning)
# Get one at: https://xtream-masters.com/
XTREAM_API_KEY=""

# Default panel URL for reseller-provisioned lines
# Per-line serverUrl overrides this when set
# Example: http://your-reseller-panel.tld:8080
XTREAM_SERVER_URL=""

# ============================================================
# DEV ONLY — auto-set by sandbox, override for prod
# ============================================================

NODE_ENV="development"
