// PlayBeat TV — IPTV Playlist Manager
// Minimal schema: Playlists + Channels only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// PLAYLIST — a named collection of channels exportable as M3U
// =========================================================
model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String?
  epgUrl      String?  // global EPG URL for the playlist (XMLTV)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels Channel[]

  @@index([updatedAt])
}

// =========================================================
// CHANNEL — a single playlist entry
// =========================================================
model Channel {
  id          String   @id @default(cuid())
  playlistId  String
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  name        String                // Channel Name (display name in M3U)
  streamUrl   String                // Stream URL (HLS, MP4, etc.)
  category    String?               // Category (group-title in M3U)
  logoUrl     String?               // Logo URL (tvg-logo in M3U)
  epgUrl      String?               // Per-channel EPG URL (rare; usually on playlist)
  tvgId       String?               // tvg-id (for EPG matching)
  tvgName     String?               // tvg-name (alternate display)
  metadata    String   @default("{}") // JSON: any extra attrs (country, language, etc.)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([playlistId])
  @@index([category])
  @@index([name])
}
